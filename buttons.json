                    "cmd": "websocket_test.sh uart cb tx 3 8",
                    "target": 1,
                    "delay": 0.7
                },
                {
                    "cmd": "websocket_test.sh uart ab rx 3 8",
                    "target": 2,
                    "delay": 0.7
